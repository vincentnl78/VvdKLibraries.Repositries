{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "Clean_AuthInterfaces",
        "Clean_AuthObjects",
        "Clean_AuthRepositries",
        "Clean_AuthServices",
        "Clean_EventPublisher",
        "Clean_EventPublisherInterfaces",
        "Clean_Repositries",
        "Clean_RepositriesContracts",
        "Compile_AuthInterfaces",
        "Compile_AuthObjects",
        "Compile_AuthRepositries",
        "Compile_AuthServices",
        "Compile_EventPublisher",
        "Compile_EventPublisherInterfaces",
        "Compile_Repositries",
        "Compile_RepositriesContracts",
        "IncreaseVersion_AuthObjects",
        "IncreaseVersion_EventPublisherInterfaces",
        "IncreaseVersion_RepositriesContracts",
        "LoadSettings",
        "Pack_AuthInterfaces",
        "Pack_AuthObjects",
        "Pack_AuthRepositries",
        "Pack_AuthServices",
        "Pack_EventPublisher",
        "Pack_EventPublisherInterfaces",
        "Pack_Repositries",
        "Pack_RepositriesContracts",
        "Publish_AuthInterfaces",
        "Publish_AuthObjects",
        "Publish_AuthRepositries",
        "Publish_AuthServices",
        "Publish_EventPublisher",
        "Publish_EventPublisherInterfaces",
        "Publish_Repositries",
        "Publish_RepositriesContracts",
        "Restore_AuthInterfaces",
        "Restore_AuthObjects",
        "Restore_AuthRepositries",
        "Restore_AuthServices",
        "Restore_EventPublisher",
        "Restore_EventPublisherInterfaces",
        "Restore_Repositries",
        "Restore_RepositriesContracts",
        "SetBuildParameters_AuthInterfaces",
        "SetBuildParameters_AuthRepositries",
        "SetBuildParameters_AuthServices",
        "SetBuildParameters_EventPublisher",
        "SetBuildParameters_Repositries",
        "SetParameters_AuthObjects",
        "SetParameters_EventPublisherInterfaces",
        "SetParameters_RepositriesContracts",
        "SetVersionOfPackages_AuthInterfaces",
        "SetVersionOfPackages_AuthRepositries",
        "SetVersionOfPackages_AuthServices",
        "SetVersionOfPackages_EventPublisher",
        "SetVersionOfPackages_Repositries",
        "Test_AuthInterfaces",
        "Test_AuthObjects",
        "Test_AuthRepositries",
        "Test_AuthServices",
        "Test_EventPublisher",
        "Test_EventPublisherInterfaces",
        "Test_Repositries",
        "Test_RepositriesContracts"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet"
      ]
    },
    "NukeBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Indicates to continue a previously failed build attempt"
        },
        "Help": {
          "type": "boolean",
          "description": "Shows the help text for this build assembly"
        },
        "Host": {
          "description": "Host for execution. Default is 'automatic'",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Disables displaying the NUKE logo"
        },
        "Partition": {
          "type": "string",
          "description": "Partition to use on CI"
        },
        "Plan": {
          "type": "boolean",
          "description": "Shows the execution plan (HTML)"
        },
        "Profile": {
          "type": "array",
          "description": "Defines the profiles to load",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory during build execution"
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to be skipped. Empty list skips all dependencies",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to be invoked. Default is '{default_target}'",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Default is 'Normal'",
          "$ref": "#/definitions/Verbosity"
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "Configuration": {
          "type": "string",
          "description": "Configuration to build - Default is 'Debug' (local) or 'Release' (server)",
          "enum": [
            "Debug",
            "Release"
          ]
        },
        "GitHubOwner": {
          "type": "string"
        },
        "GitHubToken": {
          "type": "string"
        }
      }
    },
    {
      "$ref": "#/definitions/NukeBuild"
    }
  ]
}
